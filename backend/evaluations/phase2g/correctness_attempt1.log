        assert a.parts['terminal_cost'] == .2
        assert a.parts['fairness_cost'] == pytest.approx({'R0':.2,'R1':0.,'R2':.25}[arm])
        # A subsequent action starts fresh; a new boundary failure cannot charge backward.
        previous_parts = a.parts.copy()
        a.service_ticks = 0
